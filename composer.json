{
    "name": "mathsgod/php-linq",
    "description": "A provider-based LINQ-style query library for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "mathsgod/light-collections": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Light\\Linq\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../light-collections",
            "options": {
                "symlink": true
            }
        }
    ]
}
